--==================================================
-- HỆ THỐNG XỬ LÝ BAY CHUẨN (GIỮ ĐỘ CAO KHÔNG BỊ RƠI)
--==================================================

function stopFly()
    if bv then bv:Destroy(); bv = nil end
    if bg then bg:Destroy(); bg = nil end
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then hum.PlatformStand = false end
    holdPosition = nil
end

function startFly()
    stopFly()
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    
    if root and hum then
        hum.PlatformStand = true

        bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        bv.Velocity = Vector3.zero
        bv.Parent = root

        bg = Instance.new("BodyGyro")
        bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
        bg.P = 9000
        bg.CFrame = root.CFrame
        bg.Parent = root

        holdPosition = root.Position
    end
end

-- Vòng ngắm FOV
local fovCircle = nil
pcall(function()
    fovCircle = Drawing.new("Circle")
    fovCircle.Visible = false
    fovCircle.Thickness = 1.5
    fovCircle.NumSides = 60
    fovCircle.Filled = false
    fovCircle.Transparency = 0.8
    fovCircle.Color = Color3.fromRGB(0, 170, 255)
end)

local function isTeammate(targetPlayer)
    if not Config.TeamCheck then return false end
    return player.Team and targetPlayer.Team and player.Team == targetPlayer.Team
end

local function getAimTarget()
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local cam = workspace.CurrentCamera
    if not root or not cam then return nil end

    local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    local bestTarget = nil
    local bestDist = Config.FOV

    for _, targetPlayer in ipairs(Players:GetPlayers()) do
        if targetPlayer ~= player and not isTeammate(targetPlayer) then
            local tChar = targetPlayer.Character
            local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
            local tHead = tChar and tChar:FindFirstChild(Config.TargetPart)

            if tHum and tHum.Health > 0 and tHead then
                local screenPos, visible = cam:WorldToViewportPoint(tHead.Position)
                if visible and screenPos.Z > 0 then
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                    if dist < bestDist then
                        if Config.WallCheck then
                            local params = RaycastParams.new()
                            params.FilterType = Enum.RaycastFilterType.Exclude
                            params.FilterDescendantsInstances = {char}
                            local ray = workspace:Raycast(cam.CFrame.Position, tHead.Position - cam.CFrame.Position, params)
                            if ray and ray.Instance:IsDescendantOf(tChar) then
                                bestDist = dist
                                bestTarget = tHead
                            end
                        else
                            bestDist = dist
                            bestTarget = tHead
                        end
                    end
                end
            end
        end
    end

    if fovCircle then
        fovCircle.Visible = Config.EnableFOV and Config.AimAssist
        fovCircle.Radius = Config.FOV
        fovCircle.Position = center
    end

    return bestTarget
end

-- Vòng lặp Render chính
RunService.RenderStepped:Connect(function(deltaTime)
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local cam = workspace.CurrentCamera

    -- 1. Xử lý Tốc Độ Chạy
    if hum and not Config.Fly then
        hum.WalkSpeed = Config.Speed and Config.SpeedValue or 16
    end

    -- 2. Xử lý Bay Giữ Nguyên Vị Trí / Độ Cao
    if Config.Fly and root and hum and cam then
        if not bv or not bv.Parent then startFly() end

        hum.PlatformStand = true
        bg.CFrame = cam.CFrame

        local speed = Config.FlyValue or 50
        local moveVector = Vector3.zero

        -- Kiểm tra người chơi có di chuyển bằng cần gạt / phím bấm không
        if hum.MoveDirection.Magnitude > 0 then
            moveVector = hum.MoveDirection * speed
        end

        local verticalSpeed = 0
        if isFlyingUp then
            verticalSpeed = speed
        elseif isFlyingDown then
            verticalSpeed = -speed
        end

        -- Nếu đang ấn nút bay/di chuyển
        if moveVector.Magnitude > 0 or verticalSpeed ~= 0 then
            bv.Velocity = Vector3.new(moveVector.X, verticalSpeed, moveVector.Z)
            holdPosition = root.Position
        else
            -- Khi thả tay ra: Khóa đứng yên vị trí và độ cao hiện tại
            bv.Velocity = Vector3.zero
            if holdPosition then
                root.CFrame = CFrame.new(holdPosition, holdPosition + cam.CFrame.LookVector)
            end
        end
    else
        if bv then stopFly() end
    end

    -- 3. Xử lý Aimbot
    if Config.AimAssist then
        local target = getAimTarget()
        if target and cam then
            local desiredCFrame = CFrame.lookAt(cam.CFrame.Position, target.Position)
            local factor = math.clamp((Config.AimStrength / 100) * (deltaTime * 30), 0.01, 1)
            cam.CFrame = cam.CFrame:Lerp(desiredCFrame, factor)
        end
    elseif fovCircle then
        fovCircle.Visible = false
    end

    -- 4. Hitbox Expander & ESP
    for _, targetPlayer in ipairs(Players:GetPlayers()) do
        if targetPlayer ~= player then
            local tChar = targetPlayer.Character
            local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
            
            if tRoot then
                if Config.ExpandHitbox and not isTeammate(targetPlayer) then
                    tRoot.Size = Vector3.new(Config.HitboxSize, Config.HitboxSize, Config.HitboxSize)
                    tRoot.Transparency = Config.HitboxTransparency
                    tRoot.Color = Color3.fromRGB(255, 0, 0)
                    tRoot.CanCollide = false
                else
                    tRoot.Size = Vector3.new(2, 2, 1)
                    tRoot.Transparency = 1
                end
            end

            if tChar then
                local highlight = tChar:FindFirstChild("HUB_ESP")
                if Config.ESP and not isTeammate(targetPlayer) then
                    if not highlight then
                        highlight = Instance.new("Highlight")
                        highlight.Name = "HUB_ESP"
                        highlight.Adornee = tChar
                        highlight.FillTransparency = 0.7
                        highlight.OutlineColor = Color3.fromRGB(0, 255, 150)
                        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        highlight.Parent = tChar
                    end
                    highlight.Enabled = true
                elseif highlight then
                    highlight.Enabled = false
                end
            end
        end
    end
end)

