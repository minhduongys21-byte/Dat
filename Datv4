local function isTeammate(targetPlayer)
    if not Config.TeamCheck then return false end
    if player.Team and targetPlayer.Team and player.Team == targetPlayer.Team then
        return true
    end
    return false
end

local espObjects = {}

local function removeESP(target)
    local highlight = espObjects[target]
    if highlight then
        highlight:Destroy()
        espObjects[target] = nil
    end
end

local function addESP(target, character)
    if target == player or not character then return end
    removeESP(target)

    local highlight = Instance.new("Highlight")
    highlight.Name = "DAT_CHUA_ESP"
    highlight.Adornee = character
    highlight.FillTransparency = 1
    
    if isTeammate(target) then
        highlight.OutlineColor = Color3.fromRGB(0, 255, 255)
    else
        highlight.OutlineColor = Color3.fromRGB(255, 0, 0)
    end

    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Enabled = Config.ESP
    highlight.Parent = gui

    espObjects[target] = highlight
end

local function watchPlayer(target)
    if target.Character then
        addESP(target, target.Character)
    end
    target.CharacterAdded:Connect(function(character)
        task.wait(0.5)
        if target.Parent == Players then
            addESP(target, character)
        end
    end)
end

for _, target in ipairs(Players:GetPlayers()) do
    watchPlayer(target)
end

Players.PlayerAdded:Connect(watchPlayer)
Players.PlayerRemoving:Connect(removeESP)

