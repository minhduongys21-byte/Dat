RunService.Heartbeat:Connect(function()
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")

    -- Cập nhật trạng thái ESP
    for target, highlight in pairs(espObjects) do
        if highlight and highlight.Parent then
            highlight.Enabled = Config.ESP
            highlight.OutlineColor = isTeammate(target) and Color3.fromRGB(0, 255, 255) or Color3.fromRGB(255, 0, 0)
        end
    end

    -- Xử lý Fly / Di chuyển
    if char and root and hum then
        if Config.Fly then
            hum.PlatformStand = false -- Giữ không đơ di chuyển trên mobile
            
            -- Đẩy lên / xuống khi ấn nút Fly Controls
            if isFlyingUp then
                root.CFrame = root.CFrame * CFrame.new(0, Config.FlyValue or 1, 0)
            end
            if isFlyingDown then
                root.CFrame = root.CFrame * CFrame.new(0, -(Config.FlyValue or 1), 0)
            end
        end

        -- Tăng tốc độ bằng phương pháp TranslateBy (Tránh lỗi WalkSpeed bị Anticheat reset)
        if Config.Speed and hum.MoveDirection.Magnitude > 0 then
            for _ = 1, (Config.SpeedValue or 1) do
                char:TranslateBy(hum.MoveDirection)
            end
        end
    end
end)

