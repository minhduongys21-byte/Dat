local function createSlider(label, key, minValue, maxValue)
    local holder = Instance.new("Frame")
    holder.Size = UDim2.new(1, -5, 0, 62)
    holder.BackgroundColor3 = Color3.fromRGB(32, 32, 44)
    holder.Parent = content

    Instance.new("UICorner", holder).CornerRadius = UDim.new(0, 8)

    local valueLabel = Instance.new("TextLabel")
    valueLabel.Size = UDim2.new(1, -12, 0, 25)
    valueLabel.Position = UDim2.fromOffset(6, 2)
    valueLabel.BackgroundTransparency = 1
    valueLabel.TextColor3 = Color3.new(1, 1, 1)
    valueLabel.TextSize = 14
    valueLabel.Font = Enum.Font.GothamMedium
    valueLabel.TextXAlignment = Enum.TextXAlignment.Left
    valueLabel.Parent = holder

    local bar = Instance.new("TextButton")
    bar.Size = UDim2.new(1, -16, 0, 16)
    bar.Position = UDim2.fromOffset(8, 36)
    bar.BackgroundColor3 = Color3.fromRGB(65, 65, 80)
    bar.Text = ""
    bar.AutoButtonColor = false
    bar.Parent = holder

    Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)

    local fill = Instance.new("Frame")
    fill.BackgroundColor3 = Color3.fromRGB(0, 255, 220)
    fill.BorderSizePixel = 0
    fill.Size = UDim2.new(0, 0, 1, 0)
    fill.Parent = bar

    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local dragging = false

    local function update(inputX)
        local width = bar.AbsoluteSize.X
        if width <= 0 then return end

        local ratio = math.clamp((inputX - bar.AbsolutePosition.X) / width, 0, 1)
        Config[key] = math.floor(minValue + ratio * (maxValue - minValue) + 0.5)

        fill.Size = UDim2.fromScale(ratio, 1)
        valueLabel.Text = label .. ": " .. Config[key]
    end

    local function updateFromInput(input)
        update(input.Position.X)
    end

    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            updateFromInput(input)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            updateFromInput(input)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    local ratio = math.clamp((Config[key] - minValue) / (maxValue - minValue), 0, 1)
    fill.Size = UDim2.fromScale(ratio, 1)
    valueLabel.Text = label .. ": " .. Config[key]
end

